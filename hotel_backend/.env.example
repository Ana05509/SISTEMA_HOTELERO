# Copiar este archivo a ".env" (en la misma carpeta) y completar con valores reales.
# ".env" nunca debe subirse al repositorio.

DJANGO_SECRET_KEY=cambia-esta-clave-por-una-generada-con-get_random_secret_key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Opcional: ruta/nombre del archivo SQLite. Si no se define, se usa
# hotel_backend/db.sqlite3 por defecto.
# DB_NAME=db.sqlite3

# Opcional: envío real de facturas/comprobantes por correo. Sin esto, los
# correos se imprimen en el log del servidor en vez de salir de verdad
# (backend de consola) — sirve para probar el flujo sin mandar nada real.
# Ejemplo con Gmail: EMAIL_HOST=smtp.gmail.com, EMAIL_PORT=587,
# EMAIL_HOST_USER=tu-correo@gmail.com, EMAIL_HOST_PASSWORD=una "contraseña
# de aplicación" (no la contraseña normal de la cuenta).
# EMAIL_HOST=smtp.tu-proveedor.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=reservas@tuhotel.com
